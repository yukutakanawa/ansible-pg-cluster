# Шаблон конфигурационного файла etcd в YAML-формате (etcd.conf.yml)
# Рендерится Ansible из Jinja2 в /etc/etcd/etcd.conf.yml
# Формат YAML поддерживается etcd 3.4+ (для 3.3 использовались .conf и флаги)

# Маркер ansible_managed — предупреждение, что файл управляется Ansible
# Значение задаётся в ansible.cfg (по умолчанию: "Ansible managed")
# Ручные правки будут перезаписаны при следующем запуске плейбука
# {{ ansible_managed }}

# Уникальное имя узла в кластере etcd
# Должно совпадать со значением в initial-cluster и в peer-URL
# Обычно совпадает с hostname узла
name: {{ etcd_name }}

# Каталог данных etcd
# Здесь хранятся WAL-логи, снапшоты, состояние members/
# Должен быть на быстром локальном диске (SSD), не на NFS
data-dir: {{ etcd_data_dir }}

# URL(ы), на которых etcd принимает клиентские подключения (порт 2379)
# Здесь слушает сам процесс (bind)
listen-client-urls: "{{ etcd_client_url }}"

# URL(ы), которые etcd анонсирует клиентам и другим узлам для подключения
# Обычно совпадает с listen-client-urls на одном узле,
# но в NAT/прокси-окружении может отличаться
advertise-client-urls: "{{ etcd_client_url }}"

# URL(ы), на которых etcd слушает peer-трафик (обмен между узлами, порт 2380)
# Peer-трафик — репликация raft-логов, heartbeat, выборы лидера
listen-peer-urls: "{{ etcd_peer_url }}"

# Peer-URL, который узел анонсирует другим членам кластера
# Именно по этому адресу другие узлы будут подключаться к данному
initial-advertise-peer-urls: "{{ etcd_peer_url }}"

# Начальный состав кластера в формате name=peer_url,name=peer_url,...
# Список формируется из переменной etcd_initial_cluster (массив) через join(',')
# Пример: "ubuntu=http://192.168.100.10:2380,debian=http://192.168.100.11:2380"
# Используется ТОЛЬКО при bootstrap кластера или добавлении узла
initial-cluster: "{{ etcd_initial_cluster | join(',') }}"

# Состояние кластера при первом запуске
# new      — создаём новый кластер (bootstrap, все узлы стартуют одновременно)
# existing — подключаемся к уже работающему кластеру (добавление узла, восстановление)
# ⚠️ При ошибке значения etcd может пересоздать кластер с потерей данных
initial-cluster-state: "{{ etcd_initial_cluster_state }}"

# Токен кластера — уникальный идентификатор
# Защищает от случайного объединения узлов из разных кластеров
# Должен быть ОДИНАКОВЫМ на всех узлах одного кластера
# При смене токена etcd расценит это как новый кластер
initial-cluster-token: "{{ etcd_cluster_token }}"

# Тип логгера
# zap   — структурированные логи в формате JSON (рекомендуется для 3.4+)
# capnslog — устаревший формат (для 3.3 и ниже)
logger: "zap"

# Уровень детализации логов
# debug — максимум деталей (для отладки)
# info  — стандартный уровень (рекомендуется для прода)
# warn  — только предупреждения и ошибки
# error — только ошибки
# dpanic/panic/fatal — критические (используются редко)
log-level: "{{ etcd_log_level }}"